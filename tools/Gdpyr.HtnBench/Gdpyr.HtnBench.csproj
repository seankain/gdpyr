<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Gdpyr.HtnBench</RootNamespace>
    <AssemblyName>gdpyr-htn-bench</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Fully optimised code from the first call. With tiering on, whichever
         measurement runs first is partly timed at tier 0 and the two rows cannot
         be compared; a server twenty minutes into a round is long past tiering. -->
    <TieredCompilation>false</TieredCompilation>
    <!-- FluidHTN's library folder: the vendored copy the game compiles
         (docs/HTN_BOTS.md §3.8). Overridable, so that a candidate commit can be
         probed and measured before it replaces the vendored one:
         dotnet run -c Release -p:FluidHtnSource=<checkout>/Fluid-HTN -->
    <FluidHtnSource Condition="'$(FluidHtnSource)' == ''">$(MSBuildThisFileDirectory)../../ThirdParty/FluidHTN</FluidHtnSource>
  </PropertyGroup>

  <ItemGroup>
    <!-- Properties/AssemblyInfo.cs is left out: its attributes collide with the
         ones the SDK generates, which is also why the vendored copy drops it. It
         only exists in an upstream checkout passed as FluidHtnSource. -->
    <Compile Include="$(FluidHtnSource)/**/*.cs"
             Exclude="$(FluidHtnSource)/Properties/**;$(FluidHtnSource)/obj/**;$(FluidHtnSource)/bin/**" />
    <!-- The factory the game plans with, so the bench measures that one. -->
    <Compile Include="../../Scripts/Sim/Htn/PooledHtnFactory.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>

</Project>
