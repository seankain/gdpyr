<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Gdpyr.HtnBench</RootNamespace>
    <AssemblyName>gdpyr-htn-bench</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Fully optimised code from the first call. With tiering on, whichever
         measurement runs first is partly timed at tier 0 and the two rows cannot
         be compared; a server twenty minutes into a round is long past tiering. -->
    <TieredCompilation>false</TieredCompilation>
    <!-- FluidHTN's library folder (docs/HTN_BOTS.md §3). The plan vendors it at
         ThirdParty/FluidHTN; until that lands, scripts/htn-bench.sh fetches the
         pinned commit into the user's cache and passes it here. -->
    <FluidHtnSource Condition="'$(FluidHtnSource)' == ''">$(MSBuildThisFileDirectory)../../ThirdParty/FluidHTN</FluidHtnSource>
  </PropertyGroup>

  <ItemGroup>
    <!-- Properties/AssemblyInfo.cs is left out: its attributes collide with the
         ones the SDK generates, which is also why the vendored copy drops it. -->
    <Compile Include="$(FluidHtnSource)/**/*.cs"
             Exclude="$(FluidHtnSource)/Properties/**;$(FluidHtnSource)/obj/**;$(FluidHtnSource)/bin/**" />
    <Compile Include="*.cs" />
  </ItemGroup>

</Project>
