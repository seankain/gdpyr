[navigation]

; The navigation map rasterizes a baked mesh's edges at its own cell size, so these
; have to match what UnitManager.BakeNavigation bakes with or the two disagree about
; where the walkable edges are. Both divide the infantry's radius, height and climb
; exactly (docs/IMPLEMENTATION_PLAN.md §M3).
3d/default_cell_size=0.2
3d/default_cell_height=0.1

[layer_names]

3d_render/layer_1="Default"
3d_render/layer_2="Weapon"
; Characters sit on their own physics layer from M2: a projectile's world query
; must not find them, because player hits are resolved against recorded hitboxes
; instead (docs/NETCODE.md §5). Units joined them on layer 3 in M3, for the same
; reason. Keep in step with Scripts/Core/CollisionLayers.cs.
3d_physics/layer_1="World"
3d_physics/layer_2="Players"
3d_physics/layer_3="Units"

[physics]

; Pinned rather than left at the engine default: server and clients must run the
; same solver for prediction to reconcile (docs/IMPLEMENTATION_PLAN.md §3). This
; project's movement was tuned under GodotPhysics3D; moving to Jolt is a one-line
; change here, to be made deliberately and re-tuned, not inherited from an engine
; default changing underneath us.
3d/physics_engine="GodotPhysics3D"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
