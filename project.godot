; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="gdpyr"
; The main menu, not the map: every launch passes through it, and one that named a
; mode on the command line passes straight through to res://Scenes/Test.tscn
; before a widget is built (Scripts/Ui/MainMenu.cs).
run/main_scene="res://Scenes/MainMenu.tscn"
config/features=PackedStringArray("4.6", "C#", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

; Order matters. Every manager holds a static Instance that the next one may read
; in _Ready, and PlayerManager is last because it is the only one that ticks: it
; drives the others in a written-down order rather than inheriting one from this
; list (docs/IMPLEMENTATION_PLAN.md §M3).
Bootstrap="*res://Scripts/Core/Bootstrap.cs"
NetworkManager="*res://Scripts/Net/NetworkManager.cs"
CombatManager="*res://Scripts/Match/CombatManager.cs"
UnitManager="*res://Scripts/Rts/UnitManager.cs"
EmplacementManager="*res://Scripts/Fps/EmplacementManager.cs"
PlayerManager="*res://Scripts/Net/PlayerManager.cs"
; After PlayerManager, and the only autoload that is not part of the simulation:
; it ticks nothing and is read by nothing. It is an autoload rather than a node in
; a scene because it has to exist at the main menu as well as in the map —
; `playdemo` is asked for before there is a round (docs/DEMOS.md §3).
GameConsole="*res://Scripts/Ui/GameConsole.cs"

[dotnet]

project/assembly_name="Gdpyr"

