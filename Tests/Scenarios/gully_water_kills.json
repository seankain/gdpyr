{
  "name": "Gully's river is a kill plane: a player and a rifleman dropped in it die, in the world's name; a player on the dry gully floor does not",
  "map": "gully",
  "seeds": [1, 2],
  "duration_ticks": 600,
  "warmup_ticks": 60,
  "roster": { "ground": 2, "strategists": 0 },

  "seats": [
    { "id": "swimmer", "team": "ground", "policy": "ground", "step_mul": 4, "script": "scripts/hold_still.json" },
    { "id": "dry", "team": "ground", "policy": "ground", "step_mul": 4, "script": "scripts/hold_still.json" }
  ],

  "spawns": [
    { "peer": "swimmer", "at": [-20, 2, 0], "look": [0, 0] },
    { "peer": "dry", "at": [-9, 5, -5], "look": [0, 0] },
    { "unit": "infantry", "team": "strategist", "at": [-8, 0.6, 85], "order": "none" }
  ],

  "assert": [
    { "metric": "counters.pilot_fallbacks", "op": "==", "value": 0 },
    { "metric": "events.kill[victim=@swimmer,attacker=0].count", "op": ">=", "value": 1 },
    { "metric": "events.kill[victim=@dry].count", "op": "==", "value": 0 },
    { "metric": "events.unit_lost[killer=0].count", "op": "==", "value": 1 },
    { "metric": "events.damage[victim=@dry].count", "op": "==", "value": 0 },
    { "metric": "observation.dry.self.position.1.min", "op": ">", "value": 0.0078 }
  ]
}
