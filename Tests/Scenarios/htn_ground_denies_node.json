{
  "name": "HTN ground bots deny the strategist its nodes: they take two, and the far one it holds",
  "bot_ai": "htn",
  "seeds": [1, 2, 3, 4],
  "duration_ticks": 5400,
  "warmup_ticks": 60,
  "roster": { "ground": 6, "strategists": 0 },

  "seats": [
    { "id": "idle", "team": "ground", "policy": "ground", "step_mul": 4, "script": "scripts/hold_still.json" }
  ],

  "spawns": [
    { "peer": "idle", "at": [110, 1, 110], "look": [0, 0] },
    { "unit": "infantry", "team": "strategist", "at": [-27, 1, -100], "order": "none" },
    { "unit": "infantry", "team": "strategist", "at": [-23, 1, -100], "order": "none" }
  ],

  "assert": [
    { "metric": "counters.pilot_fallbacks", "op": "==", "value": 0 },
    { "metric": "events.node_captured[node=2,owner=2].count", "op": ">=", "value": 1 },
    { "metric": "events.node_captured[owner=1].count", "op": ">=", "value": 2 },
    { "metric": "events.node_captured[node=2,owner=1,claimant=2].count", "op": "over_seeds", "cmp": ">=", "value": 1, "fraction": 0.5 }
  ]
}
