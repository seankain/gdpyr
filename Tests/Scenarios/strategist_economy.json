{
  "name": "the strategist spends and builds",
  "seed": 3,
  "duration_ticks": 900,
  "warmup_ticks": 120,
  "roster": { "ground": 2, "strategists": 1 },

  "seats": [
    { "id": "chair", "team": "strategist", "policy": "strategist", "step_mul": 30 }
  ],

  "assert": [
    { "metric": "events.unit_built.count", "op": ">=", "value": 1 },
    { "metric": "events.unit_built.count", "op": "between", "value": [1, 40] },
    { "metric": "observation.round.live_units.max", "op": ">", "value": 0 },
    { "metric": "observation.round.points.max", "op": ">", "value": 0 }
  ]
}
