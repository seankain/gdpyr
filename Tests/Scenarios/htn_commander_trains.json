  "assert": [
    { "metric": "counters.pilot_fallbacks", "op": "==", "value": 0 },
    { "metric": "events.unit_built[tier=6,barracks<0].count", "op": ">=", "value": 2 },
    { "metric": "events.unit_built[tier=5,barracks<0].count", "op": ">=", "value": 2 }
  ]
