    { "structure": "sniper_tower", "team": "strategist", "at": [120, 0.5, -80], "yaw": 0 },
    { "unit": "infantry", "team": "strategist", "at": [92, 1, -88], "order": "none" },
    { "unit": "infantry", "team": "strategist", "at": [96, 1, -88], "order": "none" },
    { "unit": "infantry", "team": "strategist", "at": [100, 1, -88], "order": "none" },
    { "unit": "infantry", "team": "strategist", "at": [104, 1, -88], "order": "none" },
    { "unit": "infantry", "team": "strategist", "at": [92, 1, -85], "order": "none" },
    { "unit": "infantry", "team": "strategist", "at": [96, 1, -85], "order": "none" },
    { "unit": "infantry", "team": "strategist", "at": [100, 1, -85], "order": "none" },
    { "unit": "infantry", "team": "strategist", "at": [104, 1, -85], "order": "none" },
    { "unit": "infantry", "team": "strategist", "at": [92, 1, -82], "order": "none" },
    { "unit": "infantry", "team": "strategist", "at": [96, 1, -82], "order": "none" },
    { "unit": "infantry", "team": "strategist", "at": [100, 1, -82], "order": "none" }
