{
  "name": "HTN ground bots beside a 4x4 with a person in its bed and nobody at the controls, and beside an empty one, get into neither",
  "bot_ai": "htn",
  "seeds": [1, 2],
  "duration_ticks": 900,
  "warmup_ticks": 60,
  "roster": { "ground": 3, "strategists": 0 },

  "seats": [
    { "id": "rider", "team": "ground", "policy": "ground", "step_mul": 4, "script": "scripts/hold_still.json" }
  ],

  "spawns": [
    { "vehicle": "4x4", "id": "truck", "at": [-92.4, 0.5, 103.4], "yaw": 3.1416 },
    { "vehicle": "4x4", "id": "empty", "at": [-98.4, 0.5, 112.4], "yaw": 3.1416 },
    { "peer": "rider", "seat": { "vehicle": "truck", "role": "passenger" } }
  ],

  "assert": [
    { "metric": "counters.pilot_fallbacks", "op": "==", "value": 0 },
    { "metric": "events.vehicle_entered.count", "op": "==", "value": 1 },
    { "metric": "events.vehicle_entered[peer!=@rider].count", "op": "==", "value": 0 }
  ]
}
