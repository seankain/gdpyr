{
  "name": "a driver seated in a 4x4 drives it: four seconds of throttle, two of steering, then the brake, and it ends more than 60 m east of where it stood, unhurt",
  "seeds": [1, 2],
  "duration_ticks": 600,
  "warmup_ticks": 60,
  "roster": { "ground": 1, "strategists": 0 },

  "seats": [
    { "id": "driver", "team": "ground", "policy": "ground", "step_mul": 4,
      "script": { "repeat": false, "steps": [
        { "ticks": 240, "move": [0, -1] },
        { "ticks": 120, "move": [1, -1] },
        { "ticks": 120, "move": [0, 1] },
        { "ticks": 120, "move": [0, 0] }
      ] } }
  ],

  "spawns": [
    { "vehicle": "4x4", "id": "truck", "at": [-60, 0.5, 50], "yaw": -1.5708 },
    { "peer": "driver", "seat": { "vehicle": "truck", "role": "driver" } }
  ],

  "assert": [
    { "metric": "counters.pilot_fallbacks", "op": "==", "value": 0 },
    { "metric": "events.vehicle_entered[seat=0,peer=@driver].count", "op": "==", "value": 1 },
    { "metric": "observation.driver.self.position.last", "op": ">=", "value": 0 },
    { "metric": "events.vehicle_damaged.count", "op": "==", "value": 0 },
    { "metric": "events.vehicle_exited.count", "op": "==", "value": 0 }
  ]
}
